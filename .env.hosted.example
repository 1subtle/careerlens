# Copy to .env.hosted on your server. This file contains examples, not credentials.
# Set an A/AAAA DNS record to that server before starting Caddy.
CAREERLENS_DOMAIN=career.example.com

# Generate once: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
CAREERLENS_AUTH_SECRET=

# Optional: your CareerLens repository, not the upstream Resume Matcher repository.
CAREERLENS_GITHUB_URL=

# One-time grant per verified email. Each successful AI generation costs 1 credit;
# failed operations release their reserved credits.
CAREERLENS_SIGNUP_CREDITS=20

# Use an SMTP sender verified by your mail provider.
# Port 587: starttls. Port 465: ssl. Plain SMTP is only for loopback testing.
CAREERLENS_SMTP_HOST=smtp.example.com
CAREERLENS_SMTP_PORT=587
CAREERLENS_SMTP_USERNAME=
CAREERLENS_SMTP_PASSWORD=
CAREERLENS_SMTP_FROM=CareerLens <login@example.com>
CAREERLENS_SMTP_SECURITY=starttls

# Small servers render one PDF at a time to keep Chromium memory bounded.
PDF_MAX_CONCURRENCY=1

# Hosted users share the operator's model service; users cannot edit these keys.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=

# Wechat Pay Native v3. Keep recharge disabled until merchant settings and prices are ready.
# JSON array: id, name, credits, amount_fen (integer fen), currency (CNY).
# See docs/网站部署指南.md for configuration.
CAREERLENS_CREDIT_PACKAGES=[]
CAREERLENS_WECHAT_APPID=
CAREERLENS_WECHAT_MCHID=
CAREERLENS_WECHAT_MERCHANT_SERIAL=
# PEM content may use literal \n separators. Never commit actual secrets.
CAREERLENS_WECHAT_MERCHANT_PRIVATE_KEY=
CAREERLENS_WECHAT_API_V3_KEY=
CAREERLENS_WECHAT_PLATFORM_KEY_ID=
CAREERLENS_WECHAT_PLATFORM_PUBLIC_KEY=
# Defaults to the public site URL plus /api/v1/billing/wechat/notify.
CAREERLENS_WECHAT_NOTIFY_URL=
