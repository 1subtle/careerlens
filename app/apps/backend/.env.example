# CareerLens backend. Copy to .env in this directory.
# Providers: openai, openai_compatible, azure_foundry, anthropic,
# openrouter, gemini, deepseek, groq, ollama.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-nano-2025-08-07
LLM_API_KEY=
# Optional provider endpoint, e.g. http://127.0.0.1:11434 for Ollama.
# LLM_API_BASE=
# REASONING_EFFORT=

CAREERLENS_MODE=local
# DATA_DIR=./data
HOST=127.0.0.1
PORT=8000
RELOAD=false
LOG_LEVEL=INFO
LOG_LLM=WARNING
FRONTEND_BASE_URL=http://127.0.0.1:3000
REQUEST_TIMEOUT_SECONDS=240
PDF_MAX_CONCURRENCY=1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
